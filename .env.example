# Copie para `.env` (ignorado pelo Git) e use valores descartáveis. Nunca versione valores reais.
POSTGRES_ADMIN_PASSWORD=troque-me-admin
DB_MIGRATION_PASSWORD=troque-me-migracao
DB_PASSWORD=troque-me-app

# Obrigatórios pelo perfil `local` (controle S-3): credenciais dummy e nenhuma identidade AWS.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Confiança JWT de staff (mesmos valores do os-service local) e segredo HS256 com pelo menos 256 bits.
JWT_SECRET=
JWT_STAFF_ISSUER=oficina-local
JWT_STAFF_AUDIENCE=oficina-staff-local
JWT_STAFF_KEY_ID=staff-local

# Mercado Pago sandbox: injetados fora de banda e somente quando o perfil gateway-fake NÃO estiver ativo.
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
